@{
    ViewData["Title"] = "Open redirect";
    var returnUrl = ViewData["ReturnUrl"] as string;
    var hardened = ViewData["Hardened"] as bool? ?? false;
    var error = ViewData["Error"] as string;
}

<h1>Open redirect</h1>
<p>This page demonstrates an open redirect. The vulnerable implementation follows any redirect URL, while the hardened version checks whether the target is local.</p>

<form method="get" class="mb-3">
    <input type="hidden" name="hardened" value="@hardened" />
    <div class="mb-2">
        <label class="form-label">Return URL</label>
        <input class="form-control" name="returnUrl" value="@returnUrl" placeholder="Enter a URL" />
    </div>
    <button type="submit" class="btn btn-danger">Redirect</button>
    <a class="btn btn-secondary" href="?hardened=@(!hardened)">@((hardened ? "Switch to vulnerable" : "Switch to hardened"))</a>
</form>

@if (!string.IsNullOrWhiteSpace(error))
{
    <div class="alert alert-danger">@error</div>
}

<div class="mt-3">
    <p>Example external URL: <code>https://example.com</code></p>
    <p>Example local URL: <code>/Home/Privacy</code></p>
</div>

@if (!string.IsNullOrWhiteSpace(returnUrl) && !hardened)
{
    <div class="alert alert-warning">The application will redirect without validation.</div>
}
