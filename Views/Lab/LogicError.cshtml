@{
    ViewData["Title"] = "Application Logic Error";
    var role = ViewData["Role"] as string ?? "user";
    var hardened = ViewData["Hardened"] as bool? ?? false;
    var result = ViewData["Result"] as string;
}

<h1>Application Logic Error / Broken Access Control</h1>
<p>This lab simulates an authorization bypass where the application makes insecure role decisions based on user-supplied data.</p>

<form method="get" class="lab-form mb-4">
    <div class="mb-3">
        <label class="form-label">Requested role</label>
        <select class="form-select" name="role">
            <option value="user" selected="@(role == "user")">user</option>
            <option value="manager" selected="@(role == "manager")">manager</option>
            <option value="admin" selected="@(role == "admin")">admin</option>
        </select>
    </div>
    <input type="hidden" name="hardened" value="@hardened" />
    <button type="submit" class="btn @(hardened ? "btn-success" : "btn-danger")">Submit @(hardened ? "hardened" : "vulnerable") request</button>
    <a class="btn btn-secondary" href="?role=@role&amp;hardened=@(!hardened)">@(!hardened ? "Switch to hardened" : "Switch to vulnerable")</a>
</form>

@if (!string.IsNullOrWhiteSpace(result))
{
    <div class="alert alert-info">@result</div>
}

<div class="alert @(hardened ? "alert-success" : "alert-warning")">
    @if (hardened)
    {
        <text><strong>Hardened:</strong> The application does not simply trust the supplied role value.</text>
    }
    else
    {
        <text><strong>Vulnerable:</strong> The application relies on unsafe role input and may allow unauthorized actions.</text>
    }
</div>
